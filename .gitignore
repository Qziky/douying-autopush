# =========================================================
# 敏感信息（严禁提交：API Key / 账号 Cookie / 本地私有配置）
# =========================================================
config/accounts.yaml
config/settings.local.yaml
config/*.local.yaml
config/*.local.yml
.env
.env.*
*.secret
data/cookies/
*.cookie
*.cookies

# =========================================================
# 运行时产物（日志 / 数据库 / 缓存 / 成片，运行后自动生成）
# =========================================================
data/
cache/
output/
*.log
*.db
*.sqlite
*.sqlite3

# =========================================================
# Python
# =========================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# =========================================================
# IDE / 编辑器 / 操作系统
# =========================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
