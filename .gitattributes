# 统一以 LF 存储文本文件，跨平台检出时由 Git 自动处理
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制资源（不做行尾/文本合并处理）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.mp4   binary
*.mp3   binary
*.wav   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.db    binary
*.sqlite binary
